import os
import json
import torch
import opensmile
import numpy as np
import librosa
from speechbrain.inference.interfaces import foreign_class
from transformers import pipeline

# --- CONFIGURATION ---
AUDIO_FOLDER = "./voiceovers"
OUTPUT_FILE = "voice_tags_pro.json"
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

print(f"Initializing Pro Tagger on {DEVICE}...")

# --- 1. LOAD ROBUST AI MODELS ---

# A. EMOTION (SpeechBrain - Very Robust)
# We use a model trained on IEMOCAP, the standard dataset for acting/emotion
print("Loading SpeechBrain Emotion Model...")
emotion_classifier = foreign_class(
    source="speechbrain/emotion-recognition-wav2vec2-IEMOCAP",
    pymodule_file="custom_interface.py",
    classname="CustomEncoderWav2Vec2Classifier",
    run_opts={"device": DEVICE}
)

# B. AGE & GENDER (Using a specialized pipeline)
# We use a pipeline that combines Wav2Vec2 with a regression head for age
print("Loading Age/Gender Model...")
# Note: For simplicity in this script, we use a robust HF pipeline that estimates these
# In a true production env, you might use 'speechbrain/spkrec-ecapa-voxceleb' for gender
age_gender_classifier = pipeline(
    "audio-classification", 
    model="nateraw/bert-base-uncased-emotion", # Placeholder for the logic structure
    # For real Age regression, we typically need a custom regressor. 
    # Below, we implement a 'heuristic' robust gender check using SpeechBrain
)
# (Re-using SpeechBrain for accurate Speaker Identification/Gender)
gender_classifier = foreign_class(
    source="speechbrain/spkrec-ecapa-voxceleb",
    pymodule_file="custom_interface.py",
    classname="EncoderClassifier",
    run_opts={"device": DEVICE}
)

# --- 2. ACOUSTIC ENGINE (OpenSMILE) ---
# This extracts professional 'GeMAPS' features (Geneva Minimalistic Acoustic Parameter Set)
smile = opensmile.Smile(
    feature_set=opensmile.FeatureSet.eGeMAPSv02,
    feature_level=opensmile.FeatureLevel.Functionals,
)

def get_voice_quality(file_path):
    """
    Extracts professional voice quality metrics using OpenSMILE.
    Returns: Jitter (roughness), Shimmer (breathiness), HNR (cleanliness).
    """
    try:
        # Extract features
        df = smile.process_file(file_path)
        
        # Jitter (local) -> Measures roughness/creaky voice
        jitter = df['jitterLocal_sma3nz_amean'].values[0]
        
        # Shimmer (local) -> Measures breathiness
        shimmer = df['shimmerLocaldB_sma3nz_amean'].values[0]
        
        # HNR (Harmonics to Noise Ratio) -> Higher = cleaner, Lower = hoarse/whisper
        hnr = df['HNRdBACF_log_sma3nz_amean'].values[0]
        
        # Mapping to readable tags
        quality_tags = []
        if jitter > 0.02: quality_tags.append("Rough/Gravelly")
        if shimmer > 1.5: quality_tags.append("Breathy")
        if hnr < 5.0: quality_tags.append("Hoarse/Whispery")
        if hnr > 15.0: quality_tags.append("Clean/Studio-Quality")
        
        return {
            "jitter": round(float(jitter), 4),
            "shimmer": round(float(shimmer), 4),
            "hnr": round(float(hnr), 2),
            "quality_tags": quality_tags
        }
    except Exception as e:
        print(f"OpenSMILE Error: {e}")
        return {"quality_tags": ["Analysis Failed"]}

def process_file_pro(file_path):
    # 1. Run SpeechBrain Emotion
    # Note: SpeechBrain returns [probabilities, index, scores, labels]
    out_prob, score, index, text_lab = emotion_classifier.classify_file(file_path)
    emotion = text_lab[0]
    
    # 2. Run SpeechBrain Gender (via Speaker Recognition Embeddings)
    # Note: This model is for speaker ID but implicitly learns gender strong signals
    # For explicit gender, we check the embedding similarity or use a specific classifier
    # Here we use a dedicated robust gender check if available, or fallback to simple logic
    # *For this script, let's assume standard classifier output for clarity*
    # (In real implementation, checking the 'mean' pitch from OpenSMILE is actually 
    # more robust for Gender than some AI models: Male < 160Hz < Female)
    
    # 3. Acoustic Deep Dive
    quality_metrics = get_voice_quality(file_path)
    
    # 4. Pitch & Speed (Robust)
    y, sr = librosa.load(file_path, sr=16000)
    # Use Pyin (Probabilistic YIN) - Slower but much more accurate than standard pitch tracking
    f0, voiced_flag, voiced_probs = librosa.pyin(y, fmin=librosa.note_to_hz('C2'), fmax=librosa.note_to_hz('C7'))
    avg_pitch = np.nanmean(f0)
    
    # Gender Logic based on Robust Pitch (Physics never lies!)
    predicted_gender = "Male" if avg_pitch < 165 else "Female"
    
    return {
        "filename": os.path.basename(file_path),
        "ai_tags": {
            "emotion_robust": emotion,
            "gender_physics": predicted_gender
        },
        "acoustic_features": {
            "pitch_hz": round(avg_pitch, 1) if not np.isnan(avg_pitch) else 0,
            "roughness": quality_metrics['jitter'],
            "breathiness": quality_metrics['shimmer'],
            "studio_quality": quality_metrics['hnr']
        },
        "generated_tags": [emotion, predicted_gender] + quality_metrics['quality_tags']
    }

# --- MAIN LOOP ---
if __name__ == "__main__":
    results = []
    if not os.path.exists(AUDIO_FOLDER):
        os.makedirs(AUDIO_FOLDER)
    
    files = [f for f in os.listdir(AUDIO_FOLDER) if f.endswith('.wav')]
    print(f"Found {len(files)} files. Starting robust analysis (this will be slow)...")
    
    for f in files:
        f_path = os.path.join(AUDIO_FOLDER, f)
        data = process_file_pro(f_path)
        results.append(data)
        print(f"Analyzed {f}: {data['generated_tags']}")

    with open(OUTPUT_FILE, 'w') as f:
        json.dump(results, f, indent=4)
    print("Done.")
